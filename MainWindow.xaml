<Window x:Class="WindX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WindX.Controls"
        Title="WindX"
        Width="640" Height="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <Grid x:Name="Root" Opacity="0">
        <!-- Intro: streaks of wind blow across before the island lands -->
        <Canvas x:Name="WindLayer" IsHitTestVisible="False" ClipToBounds="True"/>

        <!-- Nearly invisible strip that wakes the island when it is tucked away -->
        <Border x:Name="WakeZone" Width="130" Height="16" Background="#01000000"
                HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed"/>

        <!-- A tag hanging from the island on a thread: a quote, or your own reminder -->
        <Grid x:Name="NoteHost" Width="168" HorizontalAlignment="Left" VerticalAlignment="Top"
              Opacity="0" IsHitTestVisible="False" Cursor="Hand" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <RotateTransform x:Name="NoteSwing" Angle="2"/>
            </Grid.RenderTransform>
            <StackPanel>
                <Rectangle Width="1.2" Height="28" HorizontalAlignment="Center" Fill="#D8D9D2C4"/>
                <Border x:Name="NoteCard" CornerRadius="6" Padding="13,18,13,13" BorderThickness="1">
                    <Grid>
                        <Ellipse Width="7" Height="7" Fill="#70000000" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-12,0,0"/>
                        <TextBlock x:Name="NoteText" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                   FontFamily="Ink Free, Segoe Print, Segoe UI" LineHeight="18"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <Grid x:Name="Island" Width="36" Height="36" Margin="0,8,0,0"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              RenderTransformOrigin="0.5,0" Cursor="Hand">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="IslandDrop"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Soft glow: stacked translucent pills (far cheaper than a blur effect) -->
            <Grid x:Name="GlowHost" IsHitTestVisible="False"/>

            <!-- The pill itself -->
            <Border x:Name="Shell" Background="{DynamicResource IslandBg}"
                    BorderBrush="{DynamicResource IslandBorder}" BorderThickness="1" CornerRadius="18"/>

            <!-- Hairline of light along the top edge: gives the pill some depth -->
            <Border x:Name="Sheen" Margin="1" BorderThickness="1" CornerRadius="17" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2CFFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>

            <!-- Everything inside is clipped to the pill shape -->
            <Grid x:Name="ContentHost">

                <!-- Optional picture from the user's PC, drifting slowly like a camera move -->
                <Image x:Name="BgPic" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BgPicScale" ScaleX="1.12" ScaleY="1.12"/>
                            <TranslateTransform x:Name="BgPicShift"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Border x:Name="BgScrim" Background="Black" Opacity="0" IsHitTestVisible="False"/>

                <!-- Living backdrop: wind / water / fire / aurora / stars -->
                <c:EffectLayer x:Name="Fx"/>

                <!-- Team / custom name lettered across the back of the open island -->
                <TextBlock x:Name="BgName" FontSize="50" FontWeight="Black" FontStyle="Italic" Opacity="0" IsHitTestVisible="False"
                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,18,0"
                           TextWrapping="NoWrap"/>

                <!-- ============ COMPACT ============ -->
                <Grid x:Name="CompactView" Height="36" VerticalAlignment="Top" Margin="7,0,12,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border x:Name="CArt" Width="24" Height="24" CornerRadius="7" Background="{DynamicResource ChipBg}"
                                Visibility="Collapsed">
                            <Grid>
                                <TextBlock Text="&#xEC4F;" FontFamily="{DynamicResource Icons}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border CornerRadius="7">
                                    <Border.Background>
                                        <ImageBrush x:Name="CArtBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="CClock" Margin="7,0,0,1" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <StackPanel x:Name="CWeather" Orientation="Horizontal" Margin="11,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <c:WeatherIcon x:Name="CWeatherIcon" Width="16" Height="16"
                                           Fill="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CWeatherText" Margin="5,0,0,1" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <c:VisualizerBars x:Name="CBars" Height="16" Visibility="Collapsed"/>
                        <StackPanel x:Name="CBattery" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CBatteryText" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,1"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <c:BatteryGlyph Stroke="{DynamicResource TextSecondary}" x:Name="CBatteryGlyph" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ============ TOASTS (volume / power / now playing) ============ -->
                <Grid x:Name="ToastView" Height="36" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">

                    <Grid x:Name="TVolume" Margin="14,0,14,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TVolIcon" Text="&#xE995;" FontFamily="{DynamicResource Icons}" FontSize="15"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <Grid x:Name="VolTrack" Grid.Column="1" Height="5" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Border Background="{DynamicResource TrackBg}" CornerRadius="2.5"/>
                            <Border x:Name="VolFill" Background="{DynamicResource Accent}" CornerRadius="2.5"
                                    HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <TextBlock x:Name="TVolText" Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,1"/>
                    </Grid>

                    <Grid x:Name="TPower" Margin="14,0,12,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="TPowerIcon" Text="&#xE945;" FontFamily="{DynamicResource Icons}" FontSize="13"
                                       Foreground="{DynamicResource Green}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TPowerText" Text="Charging" Margin="8,0,0,1" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TPowerPct" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,1"
                                       Foreground="{DynamicResource Green}" VerticalAlignment="Center"/>
                            <c:BatteryGlyph Stroke="{DynamicResource TextSecondary}" x:Name="TPowerGlyph" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="TAlert" Margin="14,0,16,0" Visibility="Collapsed">
                        <TextBlock Text="&#xEA8F;" FontFamily="{DynamicResource Icons}" FontSize="15" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TAlertText" Margin="28,0,0,1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <Grid x:Name="TTrack" Margin="7,0,13,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource ChipBg}" VerticalAlignment="Center">
                            <Border CornerRadius="7">
                                <Border.Background>
                                    <ImageBrush x:Name="TArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Border>
                        <TextBlock x:Name="TTitle" Grid.Column="1" Margin="10,0,12,1" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <c:VisualizerBars x:Name="TBars" Grid.Column="2" Height="16" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- ============ GAME OVERLAY (fullscreen): live CPU / RAM ============ -->
                <Grid x:Name="StatsCompact" Height="36" VerticalAlignment="Top" Margin="14,0,14,0"
                      Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="CPU" FontSize="11" FontWeight="SemiBold" Margin="0,1,6,0"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SCpu" Text="–" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="RAM" FontSize="11" FontWeight="SemiBold" Margin="0,1,6,0"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SMem" Text="–" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ============ INTRO ============ -->
                <StackPanel x:Name="IntroView" Height="36" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Opacity="0" IsHitTestVisible="False">
                    <c:LogoMark x:Name="IntroLogo" Width="22" Height="22" VerticalAlignment="Center" Progress="0"/>
                    <TextBlock x:Name="IntroWord" Margin="9,0,0,1" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" Opacity="0">
                        <Run Text="Wind"/><Run x:Name="IntroX" Text="X"/>
                    </TextBlock>
                </StackPanel>

                <!-- ============ EXPANDED: NOW PLAYING ============ -->
                <Grid x:Name="ExpandedMedia" Width="400" Height="182"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid x:Name="MediaBody" Margin="20,20,20,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="15" Background="{DynamicResource ChipBg}">
                                <Grid>
                                    <TextBlock Text="&#xEC4F;" FontFamily="{DynamicResource Icons}" FontSize="24"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border CornerRadius="15">
                                        <Border.Background>
                                            <ImageBrush x:Name="EArtBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ETitle" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="EArtist" FontSize="13" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <c:VisualizerBars x:Name="EBars" Grid.Column="2" Height="24" VerticalAlignment="Center"
                                              Margin="0,0,4,0"/>
                        </Grid>

                        <Grid x:Name="ProgRow" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EPos" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Grid x:Name="ProgHit" Grid.Column="1" Background="Transparent"
                                  MouseLeftButtonUp="ProgHit_MouseLeftButtonUp">
                                <Grid x:Name="ProgTrack" Height="5" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource TrackBg}" CornerRadius="2.5"/>
                                    <Border x:Name="ProgFill" Background="{DynamicResource Accent}" CornerRadius="2.5"
                                            HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="ERem" Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <TextBlock x:Name="EClock" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="BtnPrev" Style="{DynamicResource GlyphButton}" Content="&#xE892;" Click="BtnPrev_Click"/>
                                <Button x:Name="BtnPlay" Style="{DynamicResource GlyphButton}" Content="&#xE768;" Click="BtnPlay_Click"
                                        Width="44" Height="44" FontSize="21" Margin="10,0"/>
                                <Button x:Name="BtnNext" Style="{DynamicResource GlyphButton}" Content="&#xE893;" Click="BtnNext_Click"/>
                            </StackPanel>
                            <StackPanel x:Name="EBatteryPanel" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="EBatteryText" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,1"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <c:BatteryGlyph Stroke="{DynamicResource TextSecondary}" x:Name="EBatteryGlyph" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ============ EXPANDED: NOTHING PLAYING ============ -->
                <Grid x:Name="ExpandedIdle" Width="400" Height="128"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid x:Name="IdleBody" Margin="26,10,24,0" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="IGreeting" FontSize="11" FontWeight="Bold" Margin="2,0,0,-2"
                                       Foreground="{DynamicResource Accent}" Opacity="0.9"/>
                            <TextBlock x:Name="IClock" FontSize="42" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="IDate" FontSize="13" Margin="2,0,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <StackPanel x:Name="IWeather" Orientation="Horizontal" Margin="1,5,0,0" Visibility="Collapsed">
                                <c:WeatherIcon x:Name="IWeatherIcon" Width="16" Height="16"
                                               Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="IWeatherText" Margin="6,0,0,1" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel x:Name="IBatteryPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="IBatteryText" FontSize="14" FontWeight="SemiBold" Margin="0,0,7,1"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <c:BatteryGlyph Stroke="{DynamicResource TextSecondary}" x:Name="IBatteryGlyph" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <TextBlock x:Name="IVolText" FontSize="14" FontWeight="SemiBold" Margin="0,0,8,1"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="IVolIcon" Text="&#xE995;" FontFamily="{DynamicResource Icons}" FontSize="15"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Width="26" TextAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ============ EXPANDED: CALENDAR + WEATHER ============ -->
                <Grid x:Name="DayPage" Width="400" Height="252"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid x:Name="DayBody" Margin="20,16,18,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="238"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="32">
                                <TextBlock x:Name="CalTitle" FontSize="15" FontWeight="SemiBold" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                           Cursor="Hand" MouseLeftButtonUp="CalTitle_Click"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{DynamicResource GlyphButton}" Width="28" Height="28" FontSize="11"
                                            Content="&#xE76B;" Click="CalPrev_Click"/>
                                    <Button Style="{DynamicResource GlyphButton}" Width="28" Height="28" FontSize="11"
                                            Content="&#xE76C;" Click="CalNext_Click"/>
                                </StackPanel>
                            </Grid>
                            <UniformGrid x:Name="CalGrid" Columns="7" Rows="7"/>
                        </DockPanel>

                        <Border Grid.Column="1" Margin="14,2,0,10" CornerRadius="16" Background="{DynamicResource ChipBg}">
                            <Grid Margin="12,12,10,10">
                                <TextBlock x:Name="WEmpty" TextWrapping="Wrap" FontSize="12" TextAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Text="Add your city in Settings to see the weather here."/>
                                <StackPanel x:Name="WPanel" Visibility="Collapsed">
                                    <c:WeatherIcon x:Name="WIcon" Width="34" Height="34" HorizontalAlignment="Left"
                                                   Fill="{DynamicResource Accent}"/>
                                    <TextBlock x:Name="WTemp" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="WDesc" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="WCity" FontSize="11" Margin="0,1,0,0" Opacity="0.8"
                                               Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                    <Border Height="1" Background="{DynamicResource IslandBorder}" Margin="0,9,0,7"/>
                                    <StackPanel x:Name="WForecast"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============ EXPANDED: SYSTEM ============ -->
                <Grid x:Name="SystemPage" Width="400" Height="150"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <StackPanel Margin="18,20,18,0">
                        <UniformGrid x:Name="RingRow" Columns="4">
                            <StackPanel>
                                <Grid Width="62" Height="62">
                                    <c:RingGauge x:Name="RingCpu" Fill="{DynamicResource Accent}" TrackBrush="{DynamicResource TrackBg}"/>
                                    <TextBlock x:Name="TxtCpu" Text="–" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="CPU" FontSize="11.5" FontWeight="SemiBold" Margin="0,7,0,0"
                                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <Grid Width="62" Height="62">
                                    <c:RingGauge x:Name="RingMem" Fill="{DynamicResource Accent}" TrackBrush="{DynamicResource TrackBg}"/>
                                    <TextBlock x:Name="TxtMem" Text="–" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Memory" FontSize="11.5" FontWeight="SemiBold" Margin="0,7,0,0"
                                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <Grid Width="62" Height="62">
                                    <c:RingGauge x:Name="RingDisk" Fill="{DynamicResource Accent}" TrackBrush="{DynamicResource TrackBg}"/>
                                    <TextBlock x:Name="TxtDisk" Text="–" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Disk" FontSize="11.5" FontWeight="SemiBold" Margin="0,7,0,0"
                                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="BatCell">
                                <Grid Width="62" Height="62">
                                    <c:RingGauge x:Name="RingBat" Fill="{DynamicResource Green}" TrackBrush="{DynamicResource TrackBg}"/>
                                    <TextBlock x:Name="TxtBat" Text="–" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Battery" FontSize="11.5" FontWeight="SemiBold" Margin="0,7,0,0"
                                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="SysLine" FontSize="11.5" Margin="0,13,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Grid>

                <!-- ============ EXPANDED: TIMER + POMODORO ============ -->
                <Grid x:Name="FocusPage" Width="400" Height="150"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid x:Name="FocusBody" Margin="24,20,20,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="106"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="98" Height="98" HorizontalAlignment="Left">
                            <c:RingGauge x:Name="FocusRing" Fill="{DynamicResource Accent}" TrackBrush="{DynamicResource TrackBg}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="FocusTime" Text="25:00" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="FocusMode" Text="Timer" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,4,0,0">
                            <UniformGrid Columns="4" Margin="-3,0">
                                <ToggleButton Style="{DynamicResource Chip}" Height="32" Margin="3,0" Content="5 m" Tag="5" Click="FocusPreset_Click"/>
                                <ToggleButton Style="{DynamicResource Chip}" Height="32" Margin="3,0" Content="15 m" Tag="15" Click="FocusPreset_Click"/>
                                <ToggleButton Style="{DynamicResource Chip}" Height="32" Margin="3,0" Content="25 m" Tag="25" Click="FocusPreset_Click"/>
                                <ToggleButton Style="{DynamicResource Chip}" Height="32" Margin="3,0" Content="Pomo" Tag="P" Click="FocusPreset_Click"/>
                            </UniformGrid>
                            <DockPanel Margin="0,12,0,0">
                                <Button x:Name="FocusStart" DockPanel.Dock="Left" Style="{DynamicResource GlyphButton}" Content="&#xE768;"
                                        Width="42" Height="42" FontSize="19" Click="FocusStart_Click"/>
                                <Button DockPanel.Dock="Left" Style="{DynamicResource GlyphButton}" Content="&#xE72C;" Click="FocusReset_Click"/>
                                <TextBlock x:Name="FocusHint" Margin="8,0,0,0" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ============ EXPANDED: QUICK CONTROLS (home page) ============ -->
                <Grid x:Name="ControlsPanel" Width="400" Height="112"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,104,0,0"
                      Opacity="0" IsHitTestVisible="False">
                    <Border Height="1" Background="{DynamicResource IslandBorder}" VerticalAlignment="Top" Margin="20,0"/>
                    <Grid x:Name="ControlsBody" Margin="20,14,20,10">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="SliderRow" Height="24"/>
                            <RowDefinition x:Name="GapRow" Height="12"/>
                            <RowDefinition x:Name="ChipRow" Height="38"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="BrightCol" Width="*"/>
                                <ColumnDefinition x:Name="SliderGap" Width="18"/>
                                <ColumnDefinition x:Name="VolCol" Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel x:Name="BrightPanel">
                                <TextBlock DockPanel.Dock="Left" Text="&#xE706;" FontFamily="{DynamicResource Icons}" FontSize="15"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Width="22" Margin="0,0,8,0"/>
                                <c:MiniSlider x:Name="BrightSlider" VerticalAlignment="Center"
                                              Fill="{DynamicResource Accent}" TrackBrush="{DynamicResource TrackBg}"/>
                            </DockPanel>
                            <DockPanel x:Name="VolPanel" Grid.Column="2">
                                <TextBlock x:Name="VolSliderIcon" DockPanel.Dock="Left" Text="&#xE995;"
                                           FontFamily="{DynamicResource Icons}" FontSize="15"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Width="22" Margin="0,0,8,0"/>
                                <c:MiniSlider x:Name="VolSlider" VerticalAlignment="Center"
                                              Fill="{DynamicResource Accent}" TrackBrush="{DynamicResource TrackBg}"/>
                            </DockPanel>
                        </Grid>

                        <UniformGrid x:Name="ChipGrid" Grid.Row="2" Columns="4" Margin="-4,0">
                            <ToggleButton x:Name="ChipWifi" Style="{DynamicResource Chip}" Click="ChipWifi_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE701;" FontFamily="{DynamicResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Wi-Fi" Margin="7,0,0,1" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="ChipBt" Style="{DynamicResource Chip}" Click="ChipBt_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE702;" FontFamily="{DynamicResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="BT" Margin="6,0,0,1" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="ChipMute" Style="{DynamicResource Chip}" Click="ChipMute_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74F;" FontFamily="{DynamicResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mute" Margin="7,0,0,1" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="ChipSnip" Style="{DynamicResource Chip}" Click="ChipSnip_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE722;" FontFamily="{DynamicResource Icons}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Snip" Margin="7,0,0,1" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                        </UniformGrid>
                    </Grid>
                </Grid>

                <!-- ============ EXPANDED: PAGE TABS + WATERMARK ============ -->
                <Grid x:Name="TabBar" Width="400" Height="38"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid Margin="20,0,14,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.5"
                                    IsHitTestVisible="False">
                            <c:LogoMark Width="13" Height="13" Stroke="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="WindX" FontSize="10.5" FontWeight="SemiBold" Margin="5,0,0,0"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <RadioButton x:Name="TabHome" Style="{DynamicResource TabButton}" Content="&#xE80F;" IsChecked="True"
                                         Click="Tab_Click" Tag="0"/>
                            <RadioButton x:Name="TabDay" Style="{DynamicResource TabButton}" Content="&#xE787;"
                                         Click="Tab_Click" Tag="1"/>
                            <RadioButton x:Name="TabSystem" Style="{DynamicResource TabButton}" Content="&#xE9D9;"
                                         Click="Tab_Click" Tag="2"/>
                            <RadioButton x:Name="TabFocus" Style="{DynamicResource TabButton}" Content="&#xE916;" Click="Tab_Click" Tag="3"/>
                        </StackPanel>
                        <Button Style="{DynamicResource GlyphButton}" Width="28" Height="28" FontSize="13"
                                Content="&#xE713;" Click="Gear_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondary}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
